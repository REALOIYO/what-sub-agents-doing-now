    "session-projection",
    "observability",
    "monitoring",
    "orchestration",
    "multi-agent",
    "ai-agent",
    "llm",
    "tool-progress"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REALOIYO/what-sub-agents-doing-now.git"
  },

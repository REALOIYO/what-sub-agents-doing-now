    "url": "https://github.com/REALOIYO/what-sub-agents-doing-now/issues"
  },
  "homepage": "https://github.com/REALOIYO/what-sub-agents-doing-now#readme",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1"
